{
	log {
		output discard
	}
}

malaf.alaobeidat.com {
	encode zstd gzip

	log {
		output discard
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; form-action 'none'; upgrade-insecure-requests"
		-Server
	}

	@api path /api/*
	handle @api {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		root * /var/www/malaf

		@immutable path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@noStore path / /index.html /d/*
		header @noStore Cache-Control "no-store"

		@serviceWorker path /service-worker.js /service-worker.mjs
		header @serviceWorker Cache-Control "no-store"

		try_files {path} /index.html
		file_server
	}
}
