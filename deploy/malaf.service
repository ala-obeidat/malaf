[Unit]
Description=Malaf one-time encrypted file sharing backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=malaf
Group=malaf
WorkingDirectory=/opt/malaf
ExecStart=/opt/malaf/malaf
Restart=on-failure
RestartSec=3

Environment=MALAF_ADDR=127.0.0.1:8080
Environment=MALAF_FILES_DIR=/var/lib/malaf/files
Environment=MALAF_CLAIMED_DIR=/var/lib/malaf/claimed
Environment=MALAF_MAX_UPLOAD_BYTES=104857600
Environment=MALAF_FILE_TTL=30m
Environment=MALAF_CLEANUP_INTERVAL=60s
Environment=MALAF_UPLOADS_PER_HOUR=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/malaf
UMask=0077

[Install]
WantedBy=multi-user.target
